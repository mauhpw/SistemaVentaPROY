@{
    ViewData["Title"] = "Historial Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link href="~/vendor/jquery-ui/jquery-ui.css" rel="stylesheet">
}

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">Historial de Venta</h6>
    </div>
    <div class="card-body">
        <div class="form-row align-items-end">
            <div class="form-group col-sm-3">
                <label for="cboBuscarPor">Buscar por</label>
                <select class="form-control form-control-sm" id="cboBuscarPor">
                    <option value="fecha">Fechas</option>
                    <option value="numero">Numero Venta</option>
                </select>
            </div>
            <div class="form-group col-sm-3 busqueda-fecha">
                <label for="txtFechaInicio">Fecha Inicio</label>
                <input type="text" class="form-control form-control-sm" id="txtFechaInicio">
            </div>
            <div class="form-group col-sm-3 busqueda-fecha">
                <label for="txtFechaFin">Fecha Fin</label>
                <input type="text" class="form-control form-control-sm" id="txtFechaFin">
            </div>
            <div class="form-group col-sm-3 busqueda-venta" style="display: none;">
                <label for="txtNumeroVenta">Numero Venta</label>
                <input type="text" class="form-control form-control-sm" id="txtNumeroVenta">
            </div>
            <div class="form-group col-sm-3">
                <button class="btn btn-success btn-sm btn-block" type="button" id="btnBuscar">
                    <i class="fas fa-search"></i> Buscar
                </button>
            </div>
        </div>

        <hr />
        <div class="row">
            <div class="col-sm-12">
                <table class="table table-bordered table-sm" id="tbventa" cellspacing="0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Fecha Registro</th>
                            <th>Numero Venta</th>
                            <th>Tipo Documento</th>
                            <th>Documento Cliente</th>
                            <th>Nombre Cliente</th>
                            <th>Total</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Detalle de Venta</h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="form-row">
                                <div class="form-group col-sm-4">
                                    <label for="txtFechaRegistro">Fecha Registro</label>
                                    <input type="text" class="form-control form-control-sm bg-light" id="txtFechaRegistro" readonly>
                                </div>
                                <div class="form-group col-sm-4">
                                    <label for="txtNumVenta">Numero Venta</label>
                                    <input type="text" class="form-control form-control-sm bg-light" id="txtNumVenta" readonly>
                                </div>
                                <div class="form-group col-sm-4">
                                    <label for="txtUsuarioRegistro">Usuario Registro</label>
                                    <input type="text" class="form-control form-control-sm bg-light" id="txtUsuarioRegistro" readonly>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-sm-4">
                                    <label for="txtTipoDocumento">Tipo Documento</label>
                                    <input type="text" class="form-control form-control-sm bg-light" id="txtTipoDocumento" readonly>
                                </div>
                                <div class="form-group col-sm-4">
                                    <label for="txtDocumentoCliente">RFC Cliente</label>
                                    <input type="text" class="form-control form-control-sm bg-light" id="txtDocumentoCliente" readonly>
                                </div>
                                <div class="form-group col-sm-4">
                                    <label for="txtNombreCliente">Nombre Cliente</label>
                                    <input type="text" class="form-control form-control-sm bg-light" id="txtNombreCliente" readonly>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-sm-4">
                                    <label for="txtSubTotal">Sub Total</label>
                                    <input type="text" class="form-control form-control-sm bg-light" id="txtSubTotal" readonly>
                                </div>
                                <div class="form-group col-sm-4">
                                    <label for="txtIGV">IVA</label>
                                    <input type="text" class="form-control form-control-sm bg-light" id="txtIGV" readonly>
                                </div>
                                <div class="form-group col-sm-4">
                                    <label for="txtTotal">Total</label>
                                    <input type="text" class="form-control form-control-sm bg-light font-weight-bold" id="txtTotal" readonly>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-sm-12">
                                    <table id="tbProductos" class="table table-sm table-striped">
                                        <thead>
                                            <tr>
                                                <th>Producto</th>
                                                <th>Cantidad</th>
                                                <th>Precio</th>
                                                <th>Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-success btn-sm" type="button" id="btnSolicitarFactura">
                    <i class="fas fa-file-invoice-dollar"></i> Solicitar Factura
                </button>
                <a href="#" class="btn btn-primary btn-sm" target="_blank" id="linkImprimir">Imprimir</a>
                <button class="btn btn-danger btn-sm" type="button" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalFactura" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h6 class="modal-title font-weight-bold">Datos para Facturación (CFDI 4.0)</h6>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="formFacturacion">
                    <div class="form-group">
                        <label for="cboTipoComprobante">Tipo de Comprobante</label>
                        <select class="form-control form-control-sm" id="cboTipoComprobante">
                            <option value="I">I - Ingreso (Factura de Venta)</option>
                            <option value="E">E - Egreso (Nota de Crédito)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="cboUsoCFDI">Uso del CFDI</label>
                        <select class="form-control form-control-sm" id="cboUsoCFDI">
                            <option value="G01">G01 - Adquisición de mercancías</option>
                            <option value="G03">G03 - Gastos en general</option>
                            <option value="P01">P01 - Por definir</option>
                            <option value="D01">D01 - Honorarios médicos, dentales y gastos hospitalarios</option>
                            <option value="S01">S01 - Sin efectos fiscales</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="cboRegimenFiscalReceptor">Régimen Fiscal (Receptor)</label>
                        <select class="form-control form-control-sm" id="cboRegimenFiscalReceptor">
                            <option value="601">601 - General de Ley Personas Morales</option>
                            <option value="612">612 - Personas Físicas con Actividades Empresariales</option>
                            <option value="626">626 - Régimen Simplificado de Confianza (RESICO)</option>
                            <option value="616">616 - Sin obligaciones fiscales</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="cboFormaPago">Forma de Pago</label>
                        <select class="form-control form-control-sm" id="cboFormaPago">
                            <option value="01">01 - Efectivo</option>
                            <option value="03">03 - Transferencia electrónica de fondos</option>
                            <option value="04">04 - Tarjeta de crédito</option>
                            <option value="28">28 - Tarjeta de débito</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="cboMetodoPago">Método de Pago</label>
                        <select class="form-control form-control-sm" id="cboMetodoPago">
                            <option value="PUE">PUE - Pago en una sola exhibición</option>
                            <option value="PPD">PPD - Pago en parcialidades o diferido</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-success btn-sm" type="button" id="btnGenerarFactura">Generar XML y Timbrar</button>
                <button class="btn btn-danger btn-sm" type="button" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/vendor/jquery-ui/jquery-ui.js"></script>
    <script src="~/vendor/jquery-ui/idioma/datepicker-es.js"></script>
    <script src="~/js/vistas/Historial_Venta.js"></script>

    <script>
        $(document).ready(function () {
            // Cuando se presiona "Solicitar Factura" dentro del detalle
            $("#btnSolicitarFactura").click(function () {
                // Cerramos el modal de detalles y abrimos el formulario fiscal
                $("#modalData").modal("hide");

                // Pequeño delay para evitar conflictos visuales entre modales de Bootstrap
                setTimeout(function () {
                    $("#modalFactura").modal("show");
                }, 400);
            });
        });
    </script>
}